{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fittrack.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080D1B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fittrack.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-sensors",
        {
          "motionPermission": "FitTrack usa el movimiento para registrar tus pasos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitTrack usa tu ubicación para registrar rutas durante tus actividades.",
          "locationAlwaysAndWhenInUsePermission": "FitTrack registra la ruta de tu entrenamiento aunque bloquees el teléfono. Solo durante una actividad iniciada por ti.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack usa tus fotos para tu perfil."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "fittrack",
    "backgroundColor": "#080D1B",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49e52765-4b47-4472-a6b1-473f67a1d79c"
      }
    },
    "owner": "mikis142"
  }
}
